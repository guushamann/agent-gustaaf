    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "together-ai": "^0.49.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@spider-rs/spider-rs-linux-x64-gnu": "^0.0.157",
    "@spider-rs/spider-rs-linux-arm64-gnu": "^0.0.157",
    "@spider-rs/spider-rs-darwin-arm64": "^0.0.157"
  },
  "devDependencies": {
